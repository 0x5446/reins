{
  // The public site. `rowel.novabox.ai` is the site and nothing else — the
  // relay lives on `relay.novabox.ai`, so a rule aimed at these pages can no
  // longer reach it.
  //
  // Static assets, no Worker code: there is nothing here to compute, and a
  // script would be one more thing that can break between someone tapping
  // "Privacy" in the app and a page appearing.
  //
  // Not served by the Relay, on purpose. The Relay is one process on one small
  // machine; when it is down or being upgraded, the App Store's privacy link
  // must still resolve. These pages run at the edge with no origin at all.
  //
  //   npx wrangler deploy --config site/wrangler.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rowel-site",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    // `/help` serves help.html. Without this the app's own links would 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The whole hostname, as a custom domain.
  //
  // It used to be five path-scoped routes, because the site and the Relay once
  // shared one name and a `/*` here would have swallowed `/healthz`, `/install`
  // and every `/v1`. They no longer share anything: the Relay is
  // `rowel-relay.novabox.ai`, so there is nothing left on this name to collide
  // with, and five patterns that must be kept in step with the page list is a
  // maintenance cost bought for a risk that no longer exists.
  //
  // A custom domain also provisions the DNS record and the certificate, which
  // a zone route does not — a route on a name with no record resolves nowhere.
  //
  // `/install` is a redirect declared in `public/_redirects`, not a rule typed
  // into a dashboard. The installer line is printed inside the app and cannot
  // be corrected after the fact, so what it points at belongs in the
  // repository, next to the file it serves.
  "routes": [
    { "pattern": "rowel.novabox.ai", "custom_domain": true }
  ]
}
