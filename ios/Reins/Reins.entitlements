<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The device identity lives in the Keychain, and the Keychain refuses an app
	  that carries no entitlements at all: SecItemCopyMatching answers -34018,
	  errSecMissingEntitlement. A device build gets an application-identifier from
	  its provisioning profile and is fine; a Simulator build has no profile, so
	  without this file the app cannot read its own key and declares itself
	  broken on first launch.

	  Naming the access group explicitly is also what a second target — a widget,
	  a notification service extension — would need in order to share the
	  identity, so it is worth stating rather than inheriting.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ai.novabox.reins</string>
	</array>
</dict>
</plist>
